MYSQL_ROOT_PASSWORD=replace-with-a-long-root-password
MYSQL_PASSWORD=replace-with-a-long-application-password
MYSQL_PORT=3306
REDIS_PORT=6379
HTTP_PORT=8080
WEBHOOK_SINK_PORT=18081
# Production worker settings (Compose overrides with explicit development values).
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOW_DEVELOPMENT=false
WEBHOOK_SECRET_DIR=
WORKER_METRICS_PORT=9091
WORKER_CONCURRENCY=4
# Optional OTLP/HTTP collector; omit to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=
